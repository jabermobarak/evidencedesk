ED_EMBEDDING_MODEL=
# Example model: sentence-transformers/all-MiniLM-L6-v2
# Optional local Ollama / vLLM / compatible endpoint:
ED_LLM_BASE_URL=http://localhost:11434/v1
ED_LLM_MODEL=
ED_LLM_API_KEY=
ED_MIN_SIMILARITY=0.12
ED_MIN_TOKEN_COVERAGE=0.55
